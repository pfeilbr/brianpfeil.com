{{- /* The home feed: articles, projects and architecture guides, newest
   first. Not every page on the site (Hugo's default), and not the ~290 lab
   notes, which have their own feed at /notes/index.xml. */ -}}
{{- $pages := (partial "site-articles.html" .) | union (where site.RegularPages "Section" "in" (slice "projects" "architecture")) -}}
{{- partial "rss-feed.html" (dict "page" . "pages" $pages "title" site.Title) -}}
