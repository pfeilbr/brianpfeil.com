                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "it": {
              "type": "object",
              "required": [
                "headline",
                "points"
              ],
              "additionalProperties": false,
              "properties": {
                "headline": {
                  "type": "string"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "text",
                      "refs"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "ja": {
              "type": "object",
              "required": [
                "headline",
